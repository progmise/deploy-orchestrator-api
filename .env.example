# GitHub OAuth App credentials (GitHub → Settings → Developer settings →
# OAuth Apps). Callback URL: <FRONTEND_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins allowed to use the orchestrator
ALLOWED_USERS=

# Dashboard SPA origin — OAuth redirect_uri + post-login redirect
FRONTEND_URL=https://deploy-orchestrator.vercel.app

# Local run port (Vercel sets PORT at runtime)
PORT=8080

# --- Component catalog (Supabase) -------------------------------------------
# Supabase project → Settings → API. Apply db/schema.sql in the SQL editor.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Provisioning -----------------------------------------------------------
# Fine-grained PAT owned by GITHUB_OWNER with, on all repositories:
#   Administration: RW (create repo from template, secrets/variables),
#   Contents: RW + Pull requests: RW (deploy-manifest registration PR).
PROVISIONING_TOKEN=
GITHUB_OWNER=progmise
MANIFEST_REPO=progmise/deploy-manifest

# Master copies materialized into each new repo (see SPECS in src/provision.js)
# — app templates get repo secrets VERCEL_TOKEN/DOCKER_TOKEN/ORCHESTRATOR_TOKEN
# and repo vars VERCEL_ORG_ID/VERCEL_PROJECT_ID/DOCKER_USERNAME/DEPLOY_ENVIRONMENTS.
# VERCEL_PROJECT_ID itself is propagated empty — the deploy workflow creates
# the Vercel project lazily on first deploy and fills the var.
VERCEL_TOKEN=
VERCEL_ORG_ID=
DOCKER_USERNAME=
DOCKER_TOKEN=
ORCHESTRATOR_TOKEN=
DEPLOY_ENVIRONMENTS=["pro"]

# lib templates only (publish to Maven Central):
# SONATYPE_USERNAME=
# SONATYPE_TOKEN=
# GPG_PRIVATE_KEY=
# GPG_PASSPHRASE=
