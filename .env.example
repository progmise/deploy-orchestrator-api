# --- Bootstrap (the only env vars the API truly needs in deploy) -------------
# Supabase project → Settings → API. Apply db/schema.sql in the SQL editor.
# On boot the API loads everything below from the DB itself:
#   plaintext  → app_config        (GITHUB_CLIENT_ID, ALLOWED_USERS,
#                                   FRONTEND_URL, GITHUB_OWNER)
#   secrets    → vault.secrets     (GITHUB_CLIENT_SECRET, PROVISIONING_TOKEN)
# The keys below are still read from env when absent from the DB — handy for
# local dev — but a stored value always wins.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- App config (normally in app_config / vault — env = fallback) ------------
# GitHub OAuth App credentials (GitHub → Settings → Developer settings →
# OAuth Apps). Callback URL: <FRONTEND_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins allowed to use the orchestrator
ALLOWED_USERS=

# Dashboard SPA origin — OAuth redirect_uri + post-login redirect
FRONTEND_URL=https://deploy-orchestrator.vercel.app

# Local run port (Vercel sets PORT at runtime — always env, never in DB)
PORT=8080

# --- Provisioning -----------------------------------------------------------
# Fine-grained PAT owned by GITHUB_OWNER with, on all repositories:
#   Administration: RW (create repo from template, secrets/variables),
#   Contents: RW + Pull requests: RW (deploy-manifest registration PR).
PROVISIONING_TOKEN=
GITHUB_OWNER=progmise
MANIFEST_REPO=progmise/deploy-manifest

# --- Platform credential store ----------------------------------------------
# Master copies propagated into each new repo (see SPECS in src/provision.js)
# live in SUPABASE — not here:
#   secrets → vault.secrets      (VERCEL_TOKEN, DOCKER_TOKEN, ORCHESTRATOR_TOKEN,
#                                 SONATYPE_*, GPG_*)
#   vars    → platform_vars      (VERCEL_ORG_ID, DOCKER_USERNAME, DEPLOY_ENVIRONMENTS)
# VERCEL_PROJECT_ID is propagated empty — the deploy workflow creates the
# Vercel project lazily on first deploy and fills the var.
# Any of these may still be set here as a local fallback when absent in DB.
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# DOCKER_USERNAME=
# DOCKER_TOKEN=
# ORCHESTRATOR_TOKEN=
# DEPLOY_ENVIRONMENTS=["pro"]
# SONATYPE_USERNAME= SONATYPE_TOKEN= GPG_PRIVATE_KEY= GPG_PASSPHRASE=
